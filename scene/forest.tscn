[sub_resource type="GDScript" id="GDScript_p7qo3"]
script/source = "extends CharacterBody2D

const SPEED := 200.0
const RUN_SPEED := 350.0
const ACCELERATION := 1200.0
const DECELERATION := 1500.0
const JUMP_VELOCITY := -250.0

# --- Launcher tuning ---
const MAX_PULL := 150.0   # max drag distance (pixels)
const MIN_PULL := 15.0    # shorter drags cancel the shot
const POWER := 6.0        # launch speed (px/s) per pixel of pull
const ARROW_MASS := 0.5   # must match Mass in projectile.tscn

# --- Upper body aim ---
const HIP_LOCAL := Vector2(-4.0, 20.0)  # hip inside the 48x48 frame (sprite-local px)
const TILT_SPEED := 12.0                # how fast the torso catches up with the pull
const MAX_PITCH_DEG := 35.0             # steepest lean of the waist-and-up (keeps the art off the floor)
const BOW_TIP_LOCAL := Vector2(16.0, 7.0)  # outer end of the bow, sprite-local px (drawn pose)

@export var projectile_scene: PackedScene = preload(\"res://scene/projectile.tscn\")
@export var shoot_frame := 4   # frame of the attack animation (0-7) that releases the arrow

@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var muzzle: Marker2D = $Muzzle
@onready var upper_pivot: Node2D = get_node_or_null(\"UpperPivot\")
@onready var torso: AnimatedSprite2D = upper_pivot.get_node_or_null(\"Torso\") if upper_pivot else null

var attacking := false
var aiming := false
var shot_fired := false
var launch_velocity := Vector2.ZERO
var pending_velocity := Vector2.ZERO
var gravity: float = ProjectSettings.get_setting(\"physics/2d/default_gravity\")

# --- Health ---
var health := 5
var invincible := false


func _ready() -> void:
	animated_sprite.sprite_frames.set_animation_loop(\"attack\", false)
	animated_sprite.animation_finished.connect(_on_attack_finished)
	animated_sprite.frame_changed.connect(_on_frame_changed)
	# Without the split nodes this script drives a plain sprite: drop the
	# legs-only mask so the whole character still renders.
	if torso == null:
		animated_sprite.material = null


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
		if event.pressed and not attacking:
			aiming = true
			launch_velocity = Vector2.ZERO
		elif not event.pressed and aiming:
			aiming = false
			queue_redraw()
			if launch_velocity.length() >= MIN_PULL * POWER:
				start_attack()


func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity += get_gravity() * delta

	# ATTACKING: let the animation play
	if attacking:
		velocity.x = move_toward(velocity.x, 0, DECELERATION * delta)
		move_and_slide()
		return

	# AIMING: keep the preview live while the bow is drawn
	if aiming:
		update_aim()

	# JUMP
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# MOVEMENT - unchanged while aiming, so the hero keeps walking
	var direction := Input.get_axis(\"walk_left\", \"walk_right\")
	var running := Input.is_key_pressed(KEY_SHIFT)

	if direction != 0.0:
		var target_speed := RUN_SPEED if running else SPEED
		velocity.x = move_toward(velocity.x, direction * target_speed, ACCELERATION * delta)
		animated_sprite.play(\"run\" if running else \"walk\")
	else:
		velocity.x = move_toward(velocity.x, 0, DECELERATION * delta)
		if absf(velocity.x) < 10.0:
			animated_sprite.play(\"idle\")

	# While the bow is drawn, aim owns the facing so the arrow spawns on the right side
	if not aiming:
		animated_sprite.flip_h = direction < 0.0
		muzzle.position = bow_tip_local()

	move_and_slide()


# ---------- UPPER BODY ----------

func _process(delta: float) -> void:
	if upper_pivot == null or torso == null:
		return

	# The torso plays the top half of exactly the frames the legs are showing.
	if torso.animation != animated_sprite.animation:
		torso.animation = animated_sprite.animation
	torso.frame = animated_sprite.frame
	torso.frame_progress = animated_sprite.frame_progress
	torso.flip_h = animated_sprite.flip_h

	# Sit the pivot on the hip; flipping mirrors the hip around the frame centre.
	var hip := HIP_LOCAL
	if animated_sprite.flip_h:
		hip.x = -hip.x
	upper_pivot.position = animated_sprite.position + Vector2(
		hip.x * animated_sprite.scale.x, hip.y * animated_sprite.scale.y)
	torso.position = animated_sprite.position - upper_pivot.position
	torso.scale = animated_sprite.scale

	# While the bow is drawn the waist and up leans the way the arrow will go, so
	# the body - and the bow it holds - points along the pull (mirrored when the
	# sprite faces left). The lean is capped so the art never dips below the floor.
	var target := 0.0
	if (aiming or attacking) and launch_velocity.length_squared() > 1.0:
		target = atan2(launch_velocity.y, launch_velocity.x)
		if animated_sprite.flip_h:
			target = wrapf(target + PI, -PI, PI)
		target = deg_to_rad(clampf(rad_to_deg(target), -MAX_PITCH_DEG, MAX_PITCH_DEG))
	upper_pivot.rotation = lerp_angle(upper_pivot.rotation, target, minf(1.0, TILT_SPEED * delta))

	# The arrow leaves from the outer end of the bow, leaning with the waist-and-up.
	var bow_rest := bow_tip_local()
	muzzle.position = upper_pivot.position + (bow_rest - upper_pivot.position).rotated(upper_pivot.rotation)


func bow_tip_local() -> Vector2:
	# Outer end of the bow in this body's coordinates, ignoring the torso lean.
	# The aim maths uses this so the shot direction can never chase the lean.
	var facing := -1.0 if animated_sprite.flip_h else 1.0
	return animated_sprite.position + Vector2(
		BOW_TIP_LOCAL.x * facing * animated_sprite.scale.x,
		BOW_TIP_LOCAL.y * animated_sprite.scale.y)


# ---------- AIMING ----------

func update_aim() -> void:
	var mouse := get_global_mouse_position()

	# Face the direction we will shoot (opposite to the drag)
	var facing := 1.0 if (global_position.x - mouse.x) >= 0.0 else -1.0
	animated_sprite.flip_h = facing < 0.0
	muzzle.position = bow_tip_local()

	# Slingshot: launch goes opposite to the drag. Measured from the bow's rest
	# end rather than the leaned one, so the lean can never feed back into the aim.
	var pull := (to_global(bow_tip_local()) - mouse).limit_length(MAX_PULL)
	launch_velocity = pull * POWER
	queue_redraw()


func _draw() -> void:
	if not aiming:
		return

	var anchor := to_local(muzzle.global_position)
	var mouse := to_local(get_global_mouse_position())
	var g := Vector2(0, gravity)

	# Rubber band
	var pulled := anchor - (anchor - mouse).limit_length(MAX_PULL)
	draw_line(anchor, pulled, Color.WHITE, 2.0)

	# Dotted trajectory: p = p0 + v*t + 0.5*g*t^2
	var steps := 30
	for i in range(1, steps + 1):
		var t := i * 0.06
		var p := anchor + launch_velocity * t + 0.5 * g * t * t
		var alpha := 1.0 - float(i) / steps
		draw_circle(p, 2.5, Color(1.0, 0.5, 0.0, 1.0))

	# Horizontal reference line
	var side := 1.0 if launch_velocity.x >= 0.0 else -1.0
	draw_line(anchor, anchor + Vector2(60 * side, 0), Color(1, 1, 1, 0.4), 1.0)

	# Physics values
	var speed := launch_velocity.length()
	var angle_deg := rad_to_deg(atan2(-launch_velocity.y, absf(launch_velocity.x)))
	var impulse := speed * ARROW_MASS        # J = m * v
	var vy := -launch_velocity.y
	var max_height := (vy * vy) / (2.0 * gravity) if vy > 0.0 else 0.0
	var range_px := absf(speed * speed * sin(2.0 * deg_to_rad(angle_deg)) / gravity)

	var lines := [
		\"Angle: %.1f°\" % angle_deg,
		\"Speed: %.0f px/s\" % speed,
		\"Force (impulse): %.0f N·s\" % impulse,
		\"Max height: %.0f px\" % max_height,
		\"Range: %.0f px\" % range_px,
	]
	var font := ThemeDB.fallback_font
	var pos := anchor + Vector2(-60, -90 - lines.size() * 18)
	for i in lines.size():
		draw_string(font, pos + Vector2(0, i * 18), lines[i],
			HORIZONTAL_ALIGNMENT_LEFT, -1, 16, Color.WHITE)


# ---------- ATTACK + SHOOT ----------

func start_attack() -> void:
	attacking = true
	shot_fired = false
	pending_velocity = launch_velocity
	animated_sprite.play(\"attack\")


func _on_frame_changed() -> void:
	if animated_sprite.animation == \"attack\" \\
	and animated_sprite.frame == shoot_frame \\
	and not shot_fired:
		shot_fired = true
		shoot()


func shoot() -> void:
	if projectile_scene == null:
		push_warning(\"Projectile Scene is empty on the archer!\")
		return
	var projectile: RigidBody2D = projectile_scene.instantiate()
	projectile.global_position = muzzle.global_position
	get_tree().current_scene.add_child(projectile)
	projectile.add_collision_exception_with(self)
	projectile.apply_impulse(pending_velocity * projectile.mass)


func _on_attack_finished() -> void:
	if animated_sprite.animation == \"attack\":
		attacking = false


# ---------- DAMAGE ----------

func take_damage(amount: int = 1) -> void:
	if invincible:
		return
	invincible = true
	health -= amount
	modulate = Color.RED
	await get_tree().create_timer(0.6).timeout
	modulate = Color.WHITE
	invincible = false
	if health <= 0:
		get_tree().reload_current_scene()   # placeholder game over
"

[sub_resource type="GDScript" id="GDScript_30bcl"]
script/source = "extends Camera2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

